---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import { withBase } from '../lib/paths';

const modules = (await getCollection('modules')).sort((a, b) => a.data.week - b.data.week);
const lessons = (await getCollection('lessons')).sort((a, b) => a.data.day - b.data.day);
const weeks = modules.map((module) => ({
  module,
  lessons: lessons.filter((l) => l.data.module.id === module.id),
}));
---

<BaseLayout
  title="Library"
  description="All AI Daily lessons, grouped into 12 weekly modules."
  current="library"
>
  <h1>Library</h1>
  <p class="lede">60 lessons across 12 weeks. Start anywhere, or follow the daily path.</p>

  {
    weeks.map(({ module, lessons: weekLessons }) => (
      <section class="week" aria-labelledby={`week-${module.data.week}`}>
        <p class="eyebrow">Week {module.data.week}</p>
        <h2 id={`week-${module.data.week}`}>{module.data.title}</h2>
        <p class="week__summary">{module.data.summary}</p>
        {weekLessons.length > 0 ? (
          <ol class="week__list">
            {weekLessons.map((lesson) => (
              <li>
                <a class="week__lesson" href={withBase(`lesson/${lesson.data.slug}/`)}>
                  <span class="week__day">Day {lesson.data.day}</span>
                  <span class="week__title">{lesson.data.title}</span>
                  <span class="week__meta">
                    {lesson.data.minutes + lesson.data.practice.minutes} min
                    <span class="week__done" data-done-badge data-slug={lesson.data.slug} hidden>
                      ✓ Done
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="week__soon">Coming soon</p>
        )}
      </section>
    ))
  }
</BaseLayout>

<script>
  import { isDone } from '../lib/progress';

  document.querySelectorAll<HTMLElement>('[data-done-badge]').forEach((badge) => {
    badge.hidden = !isDone(badge.dataset.slug ?? '');
  });
</script>

<style>
  .week {
    margin-top: var(--space-7);
  }
  .week h2 {
    margin-top: 0;
    margin-bottom: var(--space-2);
  }
  .week__summary {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
  .week__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .week__lesson {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'day meta'
      'title title';
    gap: var(--space-1) var(--space-3);
    min-height: var(--tap-min);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    text-decoration: none;
  }
  .week__lesson:hover {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }
  .week__day {
    grid-area: day;
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .week__title {
    grid-area: title;
    font-weight: 600;
  }
  .week__meta {
    grid-area: meta;
    justify-self: end;
    display: inline-flex;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .week__done:not([hidden]) {
    color: var(--color-accent-strong);
    font-weight: 650;
  }
  .week__soon {
    color: var(--color-ink-muted);
    font-style: italic;
    font-size: var(--text-sm);
  }
</style>
