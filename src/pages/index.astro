---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import LessonCard from '../components/LessonCard.astro';
import Onboarding from '../components/islands/Onboarding.tsx';
import { withBase } from '../lib/paths';

const TOTAL_DAYS = 60;
const lessons = (await getCollection('lessons')).sort((a, b) => a.data.day - b.data.day);
const cards = await Promise.all(
  lessons.map(async (lesson) => ({
    lesson,
    moduleTitle: (await getEntry(lesson.data.module))?.data.title,
  })),
);
---

<BaseLayout title="Today" current="today">
  <Onboarding client:only="preact" />

  <section class="today" aria-labelledby="today-heading">
    <p class="eyebrow" data-today-label>Day 1 of {TOTAL_DAYS}</p>
    <h1 id="today-heading" data-greeting>Today's AI lesson</h1>
    <p class="lede">One idea. Five minutes to read, up to fifteen to try it.</p>

    <p class="streak" data-streak hidden>
      <svg class="streak__icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
        <path
          fill="currentColor"
          d="M13.5 1.5s.9 3.1-1.3 6C10.4 9.9 8 11.2 8 14.6A4.2 4.2 0 0 0 12 19a4.2 4.2 0 0 0 4-4.4c0-1.5-.6-2.6-1.2-3.4 2.4.8 4.2 3.3 4.2 6A7 7 0 0 1 12 24a7 7 0 0 1-7-7.2c0-4.4 3.2-6.6 5.3-9.1 2-2.4 3.2-6.2 3.2-6.2z"
        ></path>
      </svg>
      <span data-streak-text></span>
    </p>

    {
      cards.map(({ lesson, moduleTitle }, i) => (
        <div data-today-card data-day={lesson.data.day} data-slug={lesson.data.slug} hidden={i !== 0}>
          <LessonCard lesson={lesson} moduleTitle={moduleTitle} />
        </div>
      ))
    }

    <p class="today__status" data-today-status role="status" hidden></p>
    <p class="today__progress" data-progress-line hidden></p>
    <p><a href={withBase('library/')}>Browse all lessons in the Library →</a></p>
  </section>
</BaseLayout>

<script>
  import { currentDay, currentStreaks, doneCount, ensureStarted, isDone } from '../lib/progress';
  import { greeting } from '../lib/personalize';
  import { load, onChange } from '../lib/storage';

  const TOTAL_DAYS = 60;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-today-card]'));
  const label = document.querySelector<HTMLElement>('[data-today-label]');
  const heading = document.querySelector<HTMLElement>('[data-greeting]');
  const status = document.querySelector<HTMLElement>('[data-today-status]');
  const progress = document.querySelector<HTMLElement>('[data-progress-line]');
  const streak = document.querySelector<HTMLElement>('[data-streak]');
  const streakText = document.querySelector<HTMLElement>('[data-streak-text]');

  const startDate = ensureStarted();

  function render() {
    if (cards.length === 0) return;
    const target = currentDay(startDate);

    // Show the latest published lesson on or before the learner's current day.
    let chosen = cards[0];
    for (const card of cards) {
      if (Number(card.dataset.day) <= target) chosen = card;
    }
    cards.forEach((card) => (card.hidden = card !== chosen));

    const chosenDay = Number(chosen.dataset.day);
    if (label) label.textContent = `Day ${chosenDay} of ${TOTAL_DAYS}`;

    const { name } = load().profile;
    if (heading) heading.textContent = name ? greeting(name) : "Today's AI lesson";

    let message = '';
    if (target > chosenDay) {
      message = "You're all caught up. New lessons are on the way, so revisit any lesson in the Library.";
    } else if (isDone(chosen.dataset.slug ?? '')) {
      message = `Done for today. Come back tomorrow for Day ${chosenDay + 1}.`;
    }
    if (status) {
      status.textContent = message;
      status.hidden = !message;
    }

    const { current, best } = currentStreaks();
    if (streak && streakText) {
      streak.hidden = best === 0;
      const days = (n: number) => `${n} day${n === 1 ? '' : 's'}`;
      streakText.textContent =
        current > 0 ? `${days(current)} streak · Best ${days(best)}` : `Best streak ${days(best)}. Start a new one today.`;
    }

    const count = doneCount();
    if (progress) {
      progress.textContent = `${count} lesson${count === 1 ? '' : 's'} completed so far.`;
      progress.hidden = count === 0;
    }
  }

  onChange(render);
</script>

<style>
  .today h1 {
    margin-bottom: var(--space-2);
  }
  .today .lede {
    margin-bottom: var(--space-5);
  }
  .streak {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-5);
  }
  .streak[hidden] {
    display: none;
  }
  .today__status {
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    border-radius: var(--radius-md);
    font-weight: 550;
  }
  .today__progress {
    margin-top: var(--space-4);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
  .today > p:last-child {
    margin-top: var(--space-5);
  }
</style>
